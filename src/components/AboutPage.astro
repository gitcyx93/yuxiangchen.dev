---
import { ABOUT, type Lang } from '../i18n/about';

interface Props {
  lang: Lang;
}

const t = ABOUT[Astro.props.lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
  </head>

  <body>
    <main class="page">
      <header class="intro">
        <p class="eyebrow">yuxiangchen.dev</p>
        <h1>{t.name}</h1>
        <p class="lede">{t.lede}</p>
      </header>

      <section>
        <h2 class="label">{t.labels.work}</h2>
        <ul class="list">
          <li>
            <a class="row" href={t.takeweave.href}>
              <span class="row-name">{t.takeweave.name}</span>
              <span class="row-desc">{t.takeweave.desc}</span>
              <span class="row-meta">{t.takeweave.meta}</span>
            </a>
          </li>

          <li class="anim">
            <div class="row row-static">
              <span class="row-name">{t.labels.animations}</span>
              <span class="row-desc">{t.animations.desc}</span>
            </div>
            <ol class="seasons">
              {
                t.animations.seasons.map((s) => (
                  <li>
                    <a class="season" href={s.href}>
                      <img src={s.thumb} alt="" width="360" height="640" loading="lazy" decoding="async" />
                      <span class="season-cap">
                        <span class="season-tag">{s.season}</span>
                        {s.name}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </li>

          {
            t.more.map((p) =>
              p.href ? (
                <li>
                  <a class="row" href={p.href}>
                    <span class="row-name">{p.name}</span>
                    <span class="row-desc">{p.desc}</span>
                    <span class="row-meta">{p.meta}</span>
                  </a>
                </li>
              ) : (
                <li>
                  <div class="row row-static">
                    <span class="row-name">{p.name}</span>
                    <span class="row-desc">{p.desc}</span>
                    <span class="row-meta">{p.meta}</span>
                  </div>
                </li>
              ),
            )
          }
        </ul>
      </section>

      <section>
        <h2 class="label">{t.labels.why}</h2>
        <div class="prose">
          {t.why.paragraphs.map((p) => <p>{p}</p>)}
          {t.why.quote.length > 0 && (
            <blockquote>
              {t.why.quote.map((line) => <span>{line}</span>)}
            </blockquote>
          )}
        </div>
      </section>

      <section>
        <h2 class="label">{t.labels.contact}</h2>
        <dl class="links">
          {
            t.contact.map((l) => (
              <div>
                <dt>{l.label}</dt>
                <dd>
                  <a href={l.href}>{l.value}</a>
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="note">{t.contactNote}</p>
      </section>

      <footer class="foot">© {new Date().getFullYear()} {t.name}</footer>
    </main>

    <style is:global>
      /* 和 Takeweave 试听页共用一套色板：暖纸、石墨、铜色 */
      :root {
        --paper: #f7f6f3;
        --ink: #23262a;
        --ink-soft: #6b6963;
        --ink-faint: #b6b3ac;
        --line: rgba(35, 38, 42, 0.14);
        --line-soft: rgba(35, 38, 42, 0.07);
        --copper: #a34a29;
        --copper-wash: rgba(163, 74, 41, 0.08);

        --sans: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue',
          'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
        --mono: ui-monospace, 'SF Mono', Menlo, 'JetBrains Mono', monospace;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #1a1b1d;
          --ink: #ecebe7;
          --ink-soft: #94918a;
          --ink-faint: #55575a;
          --line: rgba(236, 235, 231, 0.15);
          --line-soft: rgba(236, 235, 231, 0.07);
          --copper: #e38f5c;
          --copper-wash: rgba(227, 143, 92, 0.12);
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 15px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }

      ::selection {
        background: var(--copper-wash);
      }

      .page {
        max-width: 44rem;
        margin: 0 auto;
        padding: clamp(3.5rem, 14vh, 8rem) 1.25rem 2rem;
      }

      .eyebrow,
      .label {
        margin: 0 0 0.9rem;
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 400;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      h1 {
        margin: 0 0 1.1rem;
        font-size: clamp(2rem, 6vw, 2.8rem);
        font-weight: 600;
        line-height: 1.12;
        letter-spacing: -0.024em;
      }

      .lede {
        margin: 0;
        max-width: 36rem;
        color: var(--ink-soft);
      }

      section {
        margin-top: clamp(3rem, 9vh, 4.5rem);
      }

      /* 项目列表：扁平分隔线，铜色只标记可点的动作 */
      .list {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--ink);
      }

      .list > li {
        border-bottom: 1px solid var(--line-soft);
      }

      .row {
        display: grid;
        grid-template-columns: 9.5rem minmax(0, 1fr) auto;
        gap: 0.4rem 1.25rem;
        align-items: baseline;
        padding: 0.95rem 0;
        text-decoration: none;
        transition: padding-left 0.22s var(--ease);
      }

      a.row:hover {
        padding-left: 0.35rem;
      }

      .row-name {
        font-weight: 600;
      }

      .row-desc {
        font-size: 0.85rem;
        color: var(--ink-soft);
      }

      .row-meta {
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--ink-soft);
        white-space: nowrap;
        transition: color 0.18s var(--ease);
      }

      .row-static .row-meta {
        color: var(--ink-faint);
      }

      a.row:hover .row-meta,
      a.row:hover .row-name {
        color: var(--copper);
      }

      @media (max-width: 600px) {
        .row {
          grid-template-columns: 1fr auto;
        }
        .row-desc {
          grid-column: 1 / -1;
          grid-row: 2;
        }
      }

      /* 四季：竖屏海报一排四张，窄屏两两一行 */
      .seasons {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.75rem;
        margin: 0.15rem 0 0;
        padding: 0 0 1.25rem calc(9.5rem + 1.25rem);
      }

      @media (max-width: 600px) {
        .seasons {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          padding-left: 0;
        }
      }

      .season {
        display: block;
        text-decoration: none;
      }

      .season img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 9 / 16;
        object-fit: cover;
        background: var(--line-soft);
        outline: 1px solid var(--line-soft);
        transition: transform 0.35s var(--ease);
      }

      .season:hover img {
        transform: translateY(-3px);
      }

      .season-cap {
        display: flex;
        align-items: baseline;
        gap: 0.4rem;
        margin-top: 0.45rem;
        font-size: 0.8rem;
        transition: color 0.18s var(--ease);
      }

      .season-tag {
        font-family: var(--mono);
        font-size: 0.68rem;
        color: var(--ink-faint);
      }

      .season:hover .season-cap {
        color: var(--copper);
      }

      .prose p {
        margin: 0 0 1rem;
        color: var(--ink-soft);
      }

      blockquote {
        margin: 1.5rem 0 0;
        padding-left: 1rem;
        border-left: 2px solid var(--copper);
        color: var(--ink);
      }

      blockquote span {
        display: block;
      }

      .links {
        margin: 0;
        border-top: 1px solid var(--ink);
      }

      .links > div {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.65rem 0;
        border-bottom: 1px solid var(--line-soft);
      }

      .links dt {
        font-size: 0.85rem;
        color: var(--ink-soft);
      }

      .links dd {
        margin: 0;
        font-family: var(--mono);
        font-size: 0.85rem;
      }

      .links a {
        text-decoration: none;
      }

      .links a:hover {
        color: var(--copper);
      }

      .note {
        margin: 0.9rem 0 0;
        font-size: 0.8rem;
        color: var(--ink-soft);
      }

      .foot {
        margin-top: clamp(4rem, 12vh, 6rem);
        padding-top: 1.1rem;
        border-top: 1px solid var(--line-soft);
        font-size: 0.72rem;
        color: var(--ink-faint);
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
        }
      }
    </style>
  </body>
</html>
